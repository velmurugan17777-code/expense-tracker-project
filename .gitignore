# SmartTracker Enterprise — Root .gitignore

# ── Environment variables (NEVER commit these) ────────────────────────────────
.env
*.env
!.env.example

# ── Python / Django ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd
*.pyc

# Virtual environments
venv/
env/
.venv/
ENV/

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
mediafiles/

# ── Node.js / React ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# ── Docker ────────────────────────────────────────────────────────────────────
# Uncomment to ignore docker-compose overrides
# docker-compose.override.yml

# ── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDEs / Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── Testing ───────────────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/
coverage.xml
*.cover
nosetests.xml

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
