# ─────────────────────────────────────────────────────────────────────────────
# SmartTracker Enterprise – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-replace-me

DEBUG=False

# Comma-separated list of allowed host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_NAME=smarttracker_db
DB_USER=postgres
DB_PASSWORD=your_strong_db_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to False in production and specify allowed origins explicitly
CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# For development, use console backend:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# For production (Gmail SMTP):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=SmartTracker <noreply@smarttracker.io>

# ── Firebase Cloud Messaging (Push Notifications) ────────────────────────────
# FCM_SERVER_KEY=your-firebase-server-key
